# Server configuration
PORT=5000
NODE_ENV=development

# Local development database only; never reuse this value for production.
MONGODB_URI=mongodb://127.0.0.1:27017/eventhub_dev

# SMTP settings for verification, password reset, and booking confirmation mail.
# If all SMTP_* values are omitted, the legacy Gmail transport is used with
# EMAIL_USER and EMAIL_PASS. Set all three SMTP_* values for a custom provider.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_app_password

# Replace with a long random local-only secret.
JWT_SECRET=replace_with_a_long_random_secret

# Public frontend origin used to build password-reset links
FRONTEND_URL=http://localhost:5173

# Vercel Cron authorization secret for reservation expiry/reconciliation
CRON_SECRET=replace_with_a_long_random_secret
